---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedRooms } from "../../data/catalog.ts";
import { getRoomTheme } from "../../data/room-themes.ts";
import { getGroupPhotosForRoom } from "../../data/group-photos.ts";
import { formatDate, formatScore } from "../../lib/format.ts";
import type { PublishedEscapeRoom, RoomScores } from "../../types/escape-room.ts";

interface Props { room: PublishedEscapeRoom }

export async function getStaticPaths() {
  const rooms = await getPublishedRooms();
  return rooms.map((room) => ({ params: { slug: room.slug }, props: { room } }));
}

const { room } = Astro.props;
const theme = getRoomTheme(room);
const groupPhotos = getGroupPhotosForRoom(room.slug);
const artwork = room.image || (room.type === "Terror" ? "/art/terror-archive-photo.webp" : "/art/aventura-archive-photo.webp");
const scoreNames: Record<keyof RoomScores, string> = {
  acting: "Actuación", ambience: "Ambientación", entry: "Introducción", finale: "Final", puzzles: "Pruebas", terror: "Terror", history: "Historia",
};
const scoreEntries = (Object.entries(room.scores) as [keyof RoomScores, number | null][]).filter((entry): entry is [keyof RoomScores, number] => entry[1] !== null && Number.isFinite(entry[1]));
const description = room.description ?? "Consulta las puntuaciones de esta sala mientras completamos su descripción.";
const metaDescription = `Descubre ${room.name}${room.place ? ` en ${room.place}` : ""}: de qué trata y qué puntuación le dio Los Inocentes (${formatScore(room.finalScore)}/10). Sin spoilers.`;
---

<BaseLayout title={room.name} description={metaDescription} active="expedientes">
  <div class="breadcrumb"><a href="/">Inicio</a><span aria-hidden="true">/</span><a href="/expedientes/">Expedientes</a><span aria-hidden="true">/</span><span aria-current="page">{room.name}</span></div>
  <article class:list={["detail-page", theme && "theme-page", theme && `theme--${theme.id}`]} style={theme ? `--theme-backdrop: url('${theme.background}')` : undefined}>
    <header class:list={["detail-header", "section-frame", groupPhotos.length > 0 && "detail-header--with-visit", theme && "theme-detail", theme && `theme--${theme.id}`]}>
      <div class="detail-header__art"><img src={artwork} alt={room.imageAlt || ""} /><span class="detail-header__art-label">{room.image ? "IMAGEN PROMOCIONAL / WEB OFICIAL" : "IMAGEN DE ARCHIVO"}</span></div>
      <div class="detail-header__copy">
        <p class="eyebrow eyebrow--accent">EXPEDIENTE / LOS INOCENTES</p>
        {theme && <p class="detail-header__category">{room.type} / {theme.label}</p>}
        <h1>{room.name}</h1>
        {room.rankingName && room.rankingName !== room.name && <p class="detail-header__alias">En nuestro ranking: {room.rankingName}</p>}
        <p class="detail-header__summary">{description}</p>
        {groupPhotos.length > 0 && <figure class="detail-header__visit" aria-label="Fotografía del grupo en esta sala"><div class="detail-header__visit-photos">{groupPhotos.map((photo) => <button type="button" aria-label={`Ampliar fotografía: ${photo.alt}`}><img src={photo.src} alt={photo.alt} width={photo.width} height={photo.height} loading="lazy" decoding="async" /></button>)}</div></figure>}
        <div class="detail-header__meta"><span>⌖ {room.place || "Ubicación por confirmar"}</span>{room.date && <span>◷ {formatDate(room.date)}</span>}</div>
        <div class="detail-header__score"><span>VALORACIÓN DEL GRUPO</span><strong><span aria-hidden="true">★ </span>{formatScore(room.finalScore)}<small>/10</small></strong></div>
      </div>
    </header>

    <div class="detail-layout detail-layout--facts">
      <aside class="detail-aside" aria-label="Datos y notas de la sala">
        <section class="side-panel"><h2>Datos de la sala</h2><dl><div><dt>Tipo</dt><dd>{room.type}</dd></div>{theme && <div><dt>Temática</dt><dd>{theme.label}</dd></div>}<div><dt>Ubicación</dt><dd>{room.place || "Por confirmar"}</dd></div>{room.date && <div><dt>Fecha de visita</dt><dd>{formatDate(room.date)}</dd></div>}{room.company && <div><dt>Empresa</dt><dd>{room.company}</dd></div>}{room.durationMinutes && <div><dt>Duración</dt><dd>{room.durationMinutes} min</dd></div>}{room.players && <div><dt>Jugadores</dt><dd>{room.players}</dd></div>}</dl>{(room.descriptionSource || room.website) && <a class="official-link" href={room.descriptionSource || room.website} rel="noopener noreferrer">Ver web oficial <span aria-hidden="true">↗</span></a>}{room.identityStatus === "pending" && <p class="identity-note">El nombre oficial y la web de esta sala están por confirmar.</p>}</section>
        {scoreEntries.length > 0 && <section class="side-panel"><h2>Notas del grupo</h2><div class="criterion-list">{scoreEntries.map(([key, value]) => <div class="criterion"><div><span>{scoreNames[key]}</span><strong>{formatScore(value)}/10</strong></div><span class="criterion__track"><span style={`width: ${Math.max(0, Math.min(100, value * 10))}%`}></span></span></div>)}</div></section>}
        <a class="side-back-link" href="/expedientes/">← Explorar más salas</a>
      </aside>
    </div>
  </article>
  {groupPhotos.length > 0 && <dialog class="detail-photo-modal" aria-label="Fotografía del grupo ampliada"><button type="button" class="detail-photo-modal__close" aria-label="Cerrar fotografía">×</button><div class="detail-photo-modal__card"><img src={groupPhotos[0].src} alt={groupPhotos[0].alt} /></div></dialog>}
</BaseLayout>

<script>
  const photoButtons = document.querySelectorAll<HTMLButtonElement>(".detail-header__visit-photos button");
  const photoModal = document.querySelector<HTMLDialogElement>(".detail-photo-modal");
  const modalImage = photoModal?.querySelector<HTMLImageElement>(".detail-photo-modal__card img");
  const closePhoto = photoModal?.querySelector<HTMLButtonElement>(".detail-photo-modal__close");

  if (photoModal && modalImage && closePhoto && typeof photoModal.showModal === "function") {
    let trigger: HTMLButtonElement | null = null;

    photoButtons.forEach((button) => button.addEventListener("click", () => {
      const thumbnail = button.querySelector("img");
      if (!thumbnail) return;
      trigger = button;
      modalImage.src = thumbnail.currentSrc || thumbnail.src;
      modalImage.alt = thumbnail.alt;
      photoModal.showModal();
      closePhoto.focus();
    }));

    closePhoto.addEventListener("click", () => photoModal.close());
    photoModal.addEventListener("click", (event) => { if (event.target === photoModal) photoModal.close(); });
    photoModal.addEventListener("close", () => trigger?.focus());
  }
</script>
